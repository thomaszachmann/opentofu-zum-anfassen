.env
.env.*
!.env.example
*.pem
*.key
secrets/
.npmrc
# Abhängigkeiten und Build-Artefakte
node_modules/
dist/
.venv/
__pycache__/
*.pyc
*.test
# Betriebssystem und Editor
.DS_Store
